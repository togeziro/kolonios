# Production environment for Kolonios.
# Copy to /etc/kolonios/kolonios.env, chmod 600, chown root:kolonios.
#
# Generate secrets with: openssl rand -hex 32
# NOTE: VITE_* values are inlined into the client bundle at BUILD time, so this
# file must be readable by the deploy/build step, not just by the running service.

# ── Runtime ───────────────────────────────────────
NODE_ENV=production
# Bind to loopback; Caddy terminates TLS and proxies from outside.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# ── Database (self-hosted PostgreSQL on this host) ─
DATABASE_URL=postgres://kolonios:CHANGE_ME@127.0.0.1:5432/kolonios

# ── Auth (better-auth) ────────────────────────────
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
BETTER_AUTH_URL=https://app.example.com
# Comma-separated additional browser origins allowed to call the auth API.
# BETTER_AUTH_URL is always trusted; add extras here only if needed.
BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com

# ── Object storage (S3-compatible) ────────────────
# Encrypts stored storage credentials at rest. Back this up — losing it makes
# any provider credentials saved through the admin UI undecryptable.
STORAGE_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Maps (attendance) ─────────────────────────────
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Sentry (optional) ─────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Rate limiting ─────────────────────────────────
RATE_LIMIT_MAX=150
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_MAX=150
AUTH_RATE_LIMIT_MAX_SIGNIN=8

# ── Company identity (payslips, optional) ─────────
# COMPANY_NAME=
# COMPANY_ADDRESS=
# COMPANY_EMAIL=
# COMPANY_PHONE=
