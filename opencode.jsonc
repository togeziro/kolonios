{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/koloni-qw",
      "oauth": {}
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 10
  }
}
