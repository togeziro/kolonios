    "typescript": "5.9.3",
    "vite": "7.0.2",
    "vitest": "^4.1.10",
    "zod-openapi": "^6.0.0"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest/vite": "^7.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
