{
  "name": "kolonios",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Kermit",
    "url": "https://github.com/togeziro"
  },
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite dev",
    "build": "bun run api:docs && NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:app": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:docs": "bun run api:generate && redocly build-docs public/openapi.json -o public/api-docs.html",
    "start": "bun run .output/server/index.mjs",
    "lint": "oxlint && bun run lint:i18n && bun run scripts/check-layering.ts && bun run knip",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "i18n:check": "bun run scripts/check-i18n.ts",
    "lint:i18n": "bun run i18n:check && bun run i18n:hardcoded",
    "i18n:hardcoded": "bun run scripts/check-hardcoded-strings.ts",
    "i18n:baseline": "bun run scripts/check-hardcoded-strings.ts --write-baseline",
    "generate:presets": "bun run scripts/generate-theme-presets.ts",
    "api:generate": "bun run scripts/generate-openapi.ts",
    "api:docs": "bun run api:generate && redocly build-docs public/openapi.json -o public/api-docs.html",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "bun run scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:baseline": "bun run scripts/baseline-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed.ts",
    "db:reset": "bun run scripts/reset-db.ts",
    "db:list-missing-employees": "bun run scripts/list-missing-employees.ts",
    "db:backfill-missing-employees": "bun run scripts/backfill-missing-employees.ts",
    "db:studio": "drizzle-kit studio",
    "db:test:create": "bun run scripts/create-test-db.ts",
    "postinstall": "bun run scripts/postinstall.js",
    "prepare": "simple-git-hooks",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@fontsource-variable/dm-sans": "^5.1.3",
    "@fontsource-variable/fira-code": "^5.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/architects-daughter": "^5.0.17",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/space-mono": "^5.0.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/tanstackstart-react": "^10.74.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.52",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/zod-adapter": "^1.167.0",
    "@turf/distance": "^7.4.0",
    "@vladmandic/human": "^3.3.6",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^6.9.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260415-beta",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.13",
    "recharts": "3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.52.1",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "simple-git-hooks": "^2.14.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "zod-openapi": "^6.0.2"
  },
  "overrides": {
    "@tanstack/router-core": "1.171.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run generate:presets && git add src/lib/preferences/theme.ts && npx lint-staged && tsc --noEmit && bun run format:check && bun run i18n:check && bun run i18n:hardcoded",
    "prepare-commit-msg": "sh .husky/prepare-commit-msg.sh"
  }
}
