# ── Database ──────────────────────────────────────
# PostgreSQL connection string for the main application database.
DATABASE_URL=postgres://tanstack:tanstack@localhost:5432/kolonios

# PostgreSQL connection string with admin privileges, used by scripts/create-test-db.ts
# to create/drop the test database. Defaults to DATABASE_URL if not set.
DATABASE_ADMIN_URL=postgres://postgres:password@localhost:5432/postgres

# ── Auth (better-auth) ───────────────────────────
# Secret key used for signing auth tokens, session cookies, and JWTs.
# better-auth reads BETTER_AUTH_SECRET first, then legacy AUTH_SECRET.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-a-strong-64-char-hex-string

# Public base URL of the application, used by better-auth for redirect URIs and
# cookie domain. Falls back to http://localhost:3000 in development.
# Uncomment if seed scripts fail with baseURL resolution errors.
BETTER_AUTH_URL=http://localhost:3000

# ── Maps (attendance) ────────────────────────────
# Raster tile template URL used by the attendance maps (not a style JSON),
# e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── Object storage (S3-compatible) ───────────────
# AES-256-GCM key for encrypting stored storage credentials at rest.
# Generate with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ── Company identity (payslips) ──────────────────
# Optional company identity rendered on employee payslips.
# COMPANY_NAME=Kolonios
# COMPANY_ADDRESS=
# COMPANY_EMAIL=
# COMPANY_PHONE=

# ── Seed ─────────────────────────────────────────
# SEED_DEMO_ACHIEVEMENTS=1 adds the demo technician's attendance history +
# 10 completed inspection tickets so the Achievements screen shows badges.
# Note: db:seed wipes tickets + attendance and re-seeds from scratch.
# SEED_DEMO_ACHIEVEMENTS=1

# ── Logging ──────────────────────────────────────
# Pino logger level. One of: fatal, error, warn, info, debug, trace.
# Defaults to info.
LOG_LEVEL=info

# ── Node.js environment ──────────────────────────
# One of: development, production, test. Not usually set in .env;
# Set automatically by bun dev / bun run build / vitest.
# NODE_ENV=development

# ── Sentry ───────────────────────────────────────
# Error tracking DSN. When unset, Sentry is disabled (no-op) and the app
# runs exactly as before.
SENTRY_DSN=
# Fraction of transactions to trace (0 = disabled, 1 = all).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Rate limiting ───────────────────────────────
# Generic per-user server-function limiter (src/lib/rate-limit.ts).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Better Auth built-in limiter (src/lib/auth/auth.server.ts).
AUTH_RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX_SIGNIN=5
